# Supabase 프로젝트 설정 (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
# 신규 프로젝트는 Publishable key, 기존 프로젝트는 anon public key를 사용하세요 (둘 중 하나만 있으면 됩니다)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 실습용 Git 저장소 (모듈 3~4 실습에 사용할 스타터 코드 저장소 URL로 교체하세요)
NEXT_PUBLIC_STARTER_REPO_URL=
